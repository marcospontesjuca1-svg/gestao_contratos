rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function usuarioAtivo() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function ehAdmin() {
      return usuarioAtivo()
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // Fotos e anexos de imóveis: qualquer usuário ativo visualiza; só admin envia/remove.
    match /imoveis/{imovelId}/{arquivo=**} {
      allow read: if usuarioAtivo();
      allow write: if ehAdmin();
    }
  }
}
